# ClaimSaathi talks to any LLM provider with an OpenAI-compatible chat API.
# Copy this file to .env, uncomment ONE block and paste your key.
# Free tiers and model names change often — check the provider's page before the demo.

# --- Google Gemini (free tier; reads long PDFs and photos well) -------------
# Key: https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# --- Groq (free tier, very fast; pick a model that supports tool use) -------
# Key: https://console.groq.com/keys   Models: https://console.groq.com/docs/models
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile

# --- OpenRouter (has free models, names end in ":free") ---------------------
# Key: https://openrouter.ai/keys
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=<a free model that supports tools>

# --- Ollama (runs on your laptop, free and offline; no key needed) ----------
# Install from https://ollama.com, then: ollama pull qwen3:8b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:8b

# --- Claude (paid; strongest at long documents and multi-step tool use) -----
# LLM_BASE_URL=https://api.anthropic.com/v1/
# LLM_API_KEY=
# LLM_MODEL=claude-sonnet-5

# Optional: a different model for reading photos of bills (defaults to LLM_MODEL)
# LLM_VISION_MODEL=
# Safety cap on agent loop iterations per request
MAX_AGENT_STEPS=30
